# =============================================================================
# Centralised Customer Complaint Management Platform
# Copy this file to .env and adjust values. NEVER commit .env.
# =============================================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1

# PostgreSQL (Docker Compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://cmp:cmp_dev_password@localhost:5433/complaint_management?schema=public

# JWT — generate unique values for any non-local environment
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File storage: LOCAL (dev) or S3 (production)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
MAX_UPLOAD_BYTES=5242880

# AI — leave AI_API_KEY empty to use MockAIProvider (app still runs)
AI_PROVIDER=MOCK
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Email / SMS stubs — not required for MVP in-app notifications
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com

# Email IMAP Integration (FREE - for real complaint ingestion from emails)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_TLS=true

# YouTube Integration (FREE - for real complaint ingestion from YouTube comments)
# Get API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
YOUTUBE_POLLING_INTERVAL_MINUTES=2

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
